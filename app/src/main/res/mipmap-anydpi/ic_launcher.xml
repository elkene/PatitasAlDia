<?xml version="1.0" encoding="utf-8"?>
<!--
    Ícono para Android 7 (API 24 y 25), que no tiene íconos adaptativos.
    Desde Android 8 se usa la versión de mipmap-anydpi-v26.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/naranja_principal" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
