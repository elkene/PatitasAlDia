<?xml version="1.0" encoding="utf-8"?>
<!--
    Detalle en teléfono vertical: una sola columna con la información arriba
    y las vacunas y citas abajo.
    Variantes: layout-land (dos columnas) y layout-sw600dp (tableta).
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <include
            android:id="@+id/info"
            layout="@layout/include_detalle_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/vacunas"
            layout="@layout/include_detalle_vacunas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pantalla" />

        <include
            android:id="@+id/citas"
            layout="@layout/include_detalle_citas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pantalla" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
