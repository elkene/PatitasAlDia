<?xml version="1.0" encoding="utf-8"?>
<!-- Campos del formulario de mascota -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/campo_nombre">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Especie (obligatoria) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_medio"
        android:text="@string/campo_especie"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupo_especie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_perro"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/especie_perro" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_gato"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/especie_gato" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_ave"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/especie_ave" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_otro"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/especie_otro" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/txt_error_especie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error_especie_obligatoria"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_raza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:hint="@string/campo_raza">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_raza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Sexo (opcional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_medio"
        android:text="@string/campo_sexo"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupo_sexo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_macho"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sexo_macho" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_hembra"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sexo_hembra" />
    </com.google.android.material.chip.ChipGroup>

    <!-- La fecha se elige con el calendario; el campo no se puede escribir -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_fecha_nacimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:hint="@string/campo_fecha_nacimiento"
        app:endIconContentDescription="@string/borrar_fecha"
        app:endIconDrawable="@drawable/ic_cerrar"
        app:endIconMode="custom"
        app:startIconContentDescription="@string/elegir_fecha"
        app:startIconDrawable="@drawable/ic_calendario">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_fecha_nacimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cursorVisible="false"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_peso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:hint="@string/campo_peso"
        app:suffixText="@string/unidad_kg">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_peso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Datos del veterinario -->
    <TextView
        style="@style/TextoSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_pantalla"
        android:text="@string/seccion_veterinario" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_vet_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:hint="@string/campo_vet_nombre">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_vet_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_vet_telefono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:hint="@string/campo_vet_telefono"
        app:startIconDrawable="@drawable/ic_telefono">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_vet_telefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_vet_correo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:hint="@string/campo_vet_correo"
        app:startIconDrawable="@drawable/ic_correo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_vet_correo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:text="@string/campos_obligatorios"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
