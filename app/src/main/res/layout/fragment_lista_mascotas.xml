<?xml version="1.0" encoding="utf-8"?>
<!-- Lista de mascotas y mensaje que aparece cuando no hay ninguna -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- El relleno inferior evita que el botón flotante tape la última mascota -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista_mascotas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/espacio_inferior_lista"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_mascota" />

    <TextView
        android:id="@+id/txt_sin_mascotas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/margen_pantalla"
        android:gravity="center"
        android:text="@string/sin_mascotas"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
