<?xml version="1.0" encoding="utf-8"?>
<!-- Sección de citas del detalle: próximas y pasadas en listas separadas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextoSeccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/seccion_citas" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_agregar_cita"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/agregar_cita"
            android:text="@string/accion_agregar"
            app:icon="@drawable/ic_agregar" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_titulo_proximas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_minimo"
        android:text="@string/citas_proximas"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista_citas_proximas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="1"
        tools:listitem="@layout/item_cita" />

    <TextView
        android:id="@+id/txt_titulo_pasadas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_chico"
        android:text="@string/citas_pasadas"
        android:textAppearance="?attr/textAppearanceLabelLarge" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista_citas_pasadas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="1"
        tools:listitem="@layout/item_cita" />

    <TextView
        android:id="@+id/txt_sin_citas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/margen_chico"
        android:text="@string/sin_citas"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

</LinearLayout>
