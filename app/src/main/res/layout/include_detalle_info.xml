<?xml version="1.0" encoding="utf-8"?>
<!--
    Información de la mascota: foto, datos, veterinario y botones de comunicación.
    Versión de teléfono: todo en una columna con la foto arriba.
    La versión de tableta está en layout-sw600dp y debe tener los mismos ids.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_foto"
        android:layout_width="@dimen/foto_detalle"
        android:layout_height="@dimen/foto_detalle"
        android:layout_gravity="center_horizontal"
        android:background="?attr/colorPrimaryContainer"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.PatitasAlDia.Circulo" />

    <TextView
        android:id="@+id/txt_nombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_medio"
        android:gravity="center_horizontal"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        tools:text="Firulais" />

    <TextView
        android:id="@+id/txt_especie_raza"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Perro · Labrador" />

    <include
        android:id="@+id/datos"
        layout="@layout/include_detalle_datos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_pantalla" />

    <include
        android:id="@+id/botones"
        layout="@layout/include_detalle_botones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margen_medio" />

</LinearLayout>
