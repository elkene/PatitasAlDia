<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla principal en tableta (sw600dp): lista a la izquierda (1/3) y
    detalle de la mascota seleccionada a la derecha (2/3).
    MainActivity detecta este layout por la existencia de contenedor_detalle.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra_superior"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Panel izquierdo: lista y botón para agregar -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/contenedor_lista"
                android:name="com.example.patitasaldia.ui.main.ListaMascotasFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_agregar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/margen_pantalla"
                android:contentDescription="@string/agregar_mascota"
                app:srcCompat="@drawable/ic_agregar" />
        </FrameLayout>

        <View
            android:layout_width="@dimen/separador"
            android:layout_height="match_parent"
            android:background="?attr/colorOutlineVariant" />

        <!-- Panel derecho: detalle de la mascota seleccionada -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <TextView
                android:id="@+id/txt_selecciona_mascota"
                tools:ignore="InconsistentLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="@dimen/margen_pantalla"
                android:gravity="center"
                android:text="@string/selecciona_mascota"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/contenedor_detalle"
                tools:ignore="InconsistentLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
