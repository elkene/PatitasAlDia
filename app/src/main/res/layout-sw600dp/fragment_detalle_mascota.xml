<?xml version="1.0" encoding="utf-8"?>
<!--
    Detalle en tableta (panel derecho de MainActivity, en vertical y en
    horizontal): la información arriba y las vacunas y citas en dos columnas.
    El calificador sw600dp tiene prioridad sobre land, así que la tableta
    siempre usa este archivo.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <include
            android:id="@+id/info"
            layout="@layout/include_detalle_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pantalla"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/vacunas"
                layout="@layout/include_detalle_vacunas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margen_chico"
                android:layout_weight="1" />

            <include
                android:id="@+id/citas"
                layout="@layout/include_detalle_citas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_chico"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
